    "src",
    "assets/characters",
    "assets/SOURCE.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "split": "node scripts/split.mjs",
    "clean:media": "node scripts/clean-media.mjs",
    "trace": "python scripts/trace.py",
    "pack:plugin": "node scripts/pack.mjs"
  }
