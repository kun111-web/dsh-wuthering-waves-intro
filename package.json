{
  "name": "dsh-wuthering-waves-intro",
  "version": "0.4.4",
  "description": "v0.4.4 · DSH 鸣潮入场动画，20 个角色、4K 60帧静音素材、完整与快速开场",
  "type": "module",
  "license": "Apache-2.0",
  "author": "kun111-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kun111-web/dsh-wuthering-waves-intro.git"
  },
  "homepage": "https://github.com/kun111-web/dsh-wuthering-waves-intro#readme",
  "bugs": {
    "url": "https://github.com/kun111-web/dsh-wuthering-waves-intro/issues"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "wuthering-waves", "intro", "animation"],
  "publishConfig": {
